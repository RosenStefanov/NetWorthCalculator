<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash screen background — matches the icon's bg1 gradient so the transition
  from splash to app feels seamless: the full-screen gradient shrinks visually
  into the launcher icon as the user returns to the home screen.
  angle=315: startColor at top-left, endColor at bottom-right.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FF3B6BFF"
        android:centerColor="#FF5B45F5"
        android:endColor="#FF8A2EE8" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background layer — converted from networth-icon-1.svg.
  Reproduces bg1 (blue→purple diagonal) + sheen1 (white gloss, top-left fade).
  The launcher applies its own shape mask (circle / squircle / etc.) on top.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- bg1: blue (#3B6BFF) → indigo (#5B45F5) → violet (#8A2EE8), top-left → bottom-right -->
    <path android:pathData="M0,0 L1024,0 L1024,1024 L0,1024 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="120"
                android:startY="60"
                android:endX="940"
                android:endY="980">
                <item android:offset="0"    android:color="#FF3B6BFF" />
                <item android:offset="0.55" android:color="#FF5B45F5" />
                <item android:offset="1"    android:color="#FF8A2EE8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- sheen1: white gloss fading from top-left corner -->
    <path android:pathData="M0,0 L1024,0 L1024,1024 L0,1024 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="200"
                android:startY="120"
                android:endX="540"
                android:endY="640">
                <item android:offset="0" android:color="#47FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>

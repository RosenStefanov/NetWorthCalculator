<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="1024dp"
    android:height="1024dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Base squircle background (bg2 gradient) -->
    <path
        android:pathData="M230,0L794,0A230,230 0,0 1,1024 230L1024,794A230,230 0,0 1,794 1024L230,1024A230,230 0,0 1,0 794L0,230A230,230 0,0 1,230 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="120" android:startY="60"
                android:endX="940" android:endY="980"
                android:type="linear">
                <item android:offset="0" android:color="#FF3B6BFF" />
                <item android:offset="0.5" android:color="#FF5B45F5" />
                <item android:offset="1" android:color="#FF8A2EE8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sheen overlay (top-left white -> transparent) -->
    <path
        android:pathData="M230,0L794,0A230,230 0,0 1,1024 230L1024,794A230,230 0,0 1,794 1024L230,1024A230,230 0,0 1,0 794L0,230A230,230 0,0 1,230 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="200" android:startY="120"
                android:endX="560" android:endY="660"
                android:type="linear">
                <item android:offset="0" android:color="#42FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Foreground (bill + calculator + buttons), nudged up so it sits centered on the squircle -->
    <group android:name="content" android:translateY="-70">

    <!-- Dollar bill (behind, tilted -13 deg around 512,470) -->
    <group android:name="bill" android:pivotX="512" android:pivotY="470" android:rotation="-13">
        <!-- Bill body (bill2 gradient + white border) -->
        <path
            android:pathData="M280,332L744,332A34,34 0,0 1,778 366L778,546A34,34 0,0 1,744 580L280,580A34,34 0,0 1,246 546L246,366A34,34 0,0 1,280 332z"
            android:strokeColor="#B3FFFFFF"
            android:strokeWidth="6">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="246" android:startY="332"
                    android:endX="778" android:endY="580"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFF4F0FF" />
                    <item android:offset="1" android:color="#FFDCD2FB" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Corner pips -->
        <path
            android:pathData="M302,456a18,18 0,1 0,36 0a18,18 0,1 0,-36 0z"
            android:fillColor="#596C4CE0" />
        <path
            android:pathData="M686,456a18,18 0,1 0,36 0a18,18 0,1 0,-36 0z"
            android:fillColor="#596C4CE0" />
        <!-- Center seal ring -->
        <path
            android:pathData="M446,456a66,66 0,1 0,132 0a66,66 0,1 0,-132 0z"
            android:strokeColor="#8C6C4CE0"
            android:strokeWidth="10"
            android:fillColor="#00000000" />
        <!-- Bill $ glyph -->
        <path
            android:pathData="M529.24,432.52 C529.24,422.46 494.76,422.46 494.76,437.51 C494.76,450.46 529.24,451.87 529.24,466.22 C529.24,480.57 494.76,480.57 494.76,470.51"
            android:strokeColor="#B36C4CE0"
            android:strokeWidth="13"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M512,420.9L512,489.93"
            android:strokeColor="#B36C4CE0"
            android:strokeWidth="13"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>

    <!-- Calculator body (front, body2 gradient) -->
    <path
        android:pathData="M424,436L672,436A52,52 0,0 1,724 488L724,786A52,52 0,0 1,672 838L424,838A52,52 0,0 1,372 786L372,488A52,52 0,0 1,424 436z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="372" android:startY="436"
                android:endX="724" android:endY="838"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFECEFFA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Display -->
    <path
        android:pathData="M430,476L666,476A22,22 0,0 1,688 498L688,546A22,22 0,0 1,666 568L430,568A22,22 0,0 1,408 546L408,498A22,22 0,0 1,430 476z"
        android:fillColor="#FF1C2350" />
    <!-- Display ticks -->
    <path
        android:pathData="M436,508L474,508A6,6 0,0 1,474 520L436,520A6,6 0,0 1,436 508z"
        android:fillColor="#995B6BFF" />
    <path
        android:pathData="M436,530L502,530A6,6 0,0 1,502 542L436,542A6,6 0,0 1,436 530z"
        android:fillColor="#995B6BFF" />
    <!-- Display $ glyph -->
    <path
        android:pathData="M649.70,503.34 C649.70,495.34 622.30,495.34 622.30,507.31 C622.30,517.60 649.70,518.71 649.70,530.12 C649.70,541.53 622.30,541.53 622.30,533.53"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M636,494.1L636,548.97"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Buttons: cols x = 448 / 548 / 648, rows y = 620 / 710 / 800. Col 3 = accent gradient. -->
    <!-- Row 1 -->
    <path android:pathData="M422,620a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" android:fillColor="#FFE7EBF7" />
    <path android:pathData="M522,620a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" android:fillColor="#FFE7EBF7" />
    <path android:pathData="M622,620a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="648" android:startY="594" android:endX="648" android:endY="826" android:type="linear">
                <item android:offset="0" android:color="#FF5B6BFF" />
                <item android:offset="1" android:color="#FF9333EA" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Row 2 -->
    <path android:pathData="M422,710a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" android:fillColor="#FFE7EBF7" />
    <path android:pathData="M522,710a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" android:fillColor="#FFE7EBF7" />
    <path android:pathData="M622,710a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="648" android:startY="594" android:endX="648" android:endY="826" android:type="linear">
                <item android:offset="0" android:color="#FF5B6BFF" />
                <item android:offset="1" android:color="#FF9333EA" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Row 3 -->
    <path android:pathData="M422,800a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" android:fillColor="#FFE7EBF7" />
    <path android:pathData="M522,800a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" android:fillColor="#FFE7EBF7" />
    <path android:pathData="M622,800a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="648" android:startY="594" android:endX="648" android:endY="826" android:type="linear">
                <item android:offset="0" android:color="#FF5B6BFF" />
                <item android:offset="1" android:color="#FF9333EA" />
            </gradient>
        </aapt:attr>
    </path>
    </group>
</vector>
